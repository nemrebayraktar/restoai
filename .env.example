# Server port
PORT=3000

# Required. Use a long random string of your own. Do not commit the real value.
JWT_SECRET=replace-this-with-a-long-random-string

# SQLite is the default so the app runs without PostgreSQL.
# For PostgreSQL, change prisma/schema.prisma provider to "postgresql"
# and use a URL such as: postgresql://USER:PASSWORD@localhost:5432/restoai_db
DATABASE_URL="file:./dev.db"

# Optional AI services. The recommendation route falls back to the menu if these are down.
AI_RECOMMENDATION_URL=http://localhost:8001/get-recommendations
AI_ANALYTICS_URL=http://localhost:8002/get-dashboard-report

NODE_ENV=development
